# sim/Makefile.shade
# Phase 2 cocotb testbench: svo_full_tb.sv (primary trav + shading + shadow trav)

SIM           = verilator
TOPLEVEL_LANG = verilog

RTL_DIR = $(abspath ../vivado/ip/svo_raytracer/hdl)

# Fast-sim crop (mirrors sim/Makefile): RENDER_DIV downscales the render by an
# integer factor at the same FOV. DIV=1 -> full 320x240. Changing it changes
# COMPILE_ARGS, so clean the shade_build first (the `shade` target does this).
# svo_full_tb forwards IMG_W/IMG_H to its traversal instances.
RENDER_DIV ?= 1
RENDER_W   := $(shell expr 320 / $(RENDER_DIV))
RENDER_H   := $(shell expr 240 / $(RENDER_DIV))
export RENDER_DIV

VERILOG_SOURCES  = $(RTL_DIR)/shared_qmul3.sv $(RTL_DIR)/svo_traversal.sv
VERILOG_SOURCES += $(RTL_DIR)/shading_pipeline.sv
VERILOG_SOURCES += $(abspath svo_full_tb.sv)
TOPLEVEL         = svo_full_tb
MODULE           = tb_svo_full
COMPILE_ARGS     = -GIMG_W=$(RENDER_W) -GIMG_H=$(RENDER_H)

EXTRA_ARGS  = --language 1800-2012
EXTRA_ARGS += -Wno-WIDTHTRUNC -Wno-WIDTHEXPAND -Wno-CASEINCOMPLETE
EXTRA_ARGS += -Wno-UNOPTFLAT
EXTRA_ARGS += --public-flat-rw

SIM_BUILD  = shade_build

OUTPUT_DIR = output
$(shell mkdir -p $(OUTPUT_DIR))

include $(shell cocotb-config --makefiles)/Makefile.sim
