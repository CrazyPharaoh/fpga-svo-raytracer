sim/output/logs/*_trace_*.txt

# Scratch render outputs
/output*.ppm
/ppm_outputs/

# Vivado ILA capture dumps + scratch
vivado/analyser_results/
vivado/ip/check.sv

# Report lives in its own repository; keep it out of this one
private-docs/
